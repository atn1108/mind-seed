# Supabase — copy this file to `.env` and fill in real values.
# Required by src/integrations/supabase/client.ts and vite config.

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

# Vite exposes these to the browser via import.meta.env (prefix VITE_).
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Server/admin only — used by src/integrations/supabase/client.server.ts.
# NEVER expose this in the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
